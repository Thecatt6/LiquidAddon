{
  "schemaVersion": 1,
  "id": "LiquidAddon",
  "version": "${version}",
  "name": "LiquidAddon",
  "description": "LiquidBounce Addon",
  "authors": [
    "razzo715",
    "Thecatt6"
  ],
  "contact": {
    "homepage": "https://liquidbounce.net/",
    "sources": "https://github.com/Thecatt6/LiquidAddon",
    "issues": "https://github.com/Thecatt6/LiquidAddon/issues"
  },
  "license": "GPL-3.0-or-later",
  "icon": "resources/LiquidAddon/icon.png",
  "environment": "client",
  "entrypoints": {
    "liquidbounce": [
      "com.liquidaddon.Addon"
    ]
  },
  "mixins": [
    "liquidaddon.mixins.json"
  ],
  "accessWidener": "liquidaddon.accesswidener",
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "liquidbounce": "*"
  },
  "custom": {
    "liquidbounce": {
      "color": "#FF5555"
    },
    "modmenu": {
      "parent": "liquidbounce"
    }
  }
}
